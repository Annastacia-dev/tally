# Copy to .env and fill in. Never commit .env.

# --- Database (Postgres) ---
# Local: postgresql://tally:tally@localhost:5432/tally?schema=public
# Supabase: the "Transaction pooler" string (port 6543), with ?pgbouncer=true
DATABASE_URL=""
# Supabase only: the direct connection (port 5432), used for migrations.
DIRECT_URL=""

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Your app's public URL. Needed in production; optional on localhost.
AUTH_URL="http://localhost:3000"
# Google OAuth client (see README). Leave empty to run in demo mode only.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Demo mode ---
# "true" shows the "Try the demo" button (sample inbox + sample M-Pesa statement).
# Defaults to on when Google is not configured. Set "false" to hide it.
DEMO_MODE="true"

# --- Claude (email extraction) ---
# Without it, a simple rule-based extractor is used.
ANTHROPIC_API_KEY=""
# Optional override. Default: claude-opus-5-5
ANTHROPIC_MODEL=""

# --- Reminders (Brevo) ---
# Without it, reminders are logged to the console instead of sent.
BREVO_API_KEY=""
# Must be a sender address verified in your Brevo account. Either a bare
# address or with a name, e.g. "Tally <noreply@example.com>".
REMINDER_FROM_EMAIL=""
# Protects /api/cron/reminders. Vercel Cron sends it automatically when set.
CRON_SECRET=""
# Link used in reminder emails. Defaults to AUTH_URL.
APP_URL=""

# --- Optional ---
# How far back to scan Gmail, in months (default 18).
SCAN_MONTHS="18"
# Most new emails one scan reads. Later scans skip emails already read and
# continue further back.
SCAN_MAX_EMAILS="1000"
# KES per unit of other currencies, e.g. {"USD":129.5,"EUR":140}
FX_RATES_JSON=""
# Time zone for displayed dates (default Africa/Nairobi).
APP_TIMEZONE=""
# Set to "off" to show initials instead of fetching service logos.
NEXT_PUBLIC_LOGOS=""
